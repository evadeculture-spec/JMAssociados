---
interface Props { title: string; crumbs?: { href?: string; label: string }[]; bg?: 'sala' | 'biblioteca' | 'recorte' }
const { title, crumbs = [], bg = 'biblioteca' } = Astro.props;
---
<header class="page-head on-photo" data-bg={bg} data-shade="dark">
  <div class="wrap page-head-inner">
    <nav class="breadcrumb" aria-label="Localização">
      <ol>
        <li><a href="/">Início</a></li>
        {crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}
      </ol>
    </nav>
    <h1>{title}</h1>
    <slot />
  </div>
</header>
