---
// Fotografia do escritório, responsiva (AVIF/WebP/JPEG), com dimensões fixas para evitar deslocamentos.
import { Picture } from 'astro:assets';
import sala from '../assets/photos/sala-de-reunioes.jpg';
import biblioteca from '../assets/photos/biblioteca.jpg';
import recorte from '../assets/photos/biblioteca-recorte.jpg';

const photos = {
  sala: { src: sala, alt: 'Sala de reuniões do escritório, com mesa comprida em madeira, cadeiras de couro e painel com silhuetas de árvores ao fundo.' },
  biblioteca: { src: biblioteca, alt: 'Biblioteca do escritório, com estantes de livros jurídicos e mesa de reuniões sobre tapete bordô.' },
  recorte: { src: recorte, alt: 'Biblioteca do escritório em enquadramento mais próximo: estantes, mesa de reuniões e tapete bordô.' },
};

interface Props { name: keyof typeof photos; sizes: string; eager?: boolean; class?: string; alt?: string }
const { name, sizes, eager = false, class: cls = '', alt } = Astro.props;
const photo = photos[name];
---
<div class:list={['photo', cls]}>
  <Picture
    src={photo.src}
    alt={alt ?? photo.alt}
    formats={['avif', 'webp']}
    widths={[480, 800, 1200, 1600, 2400].filter((w) => w <= photo.src.width)}
    sizes={sizes}
    quality={72}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding="async"
  />
</div>
