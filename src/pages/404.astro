---
import Base from '../layouts/Base.astro';
import { nav } from '../data/site.mjs';
---
<Base title="Página não encontrada" description="A página pedida não existe." noindex>
  <div class="wrap page">
    <header class="page-head">
      <h1>Página não encontrada</h1>
      <p class="lede">O endereço pode ter mudado. Escolha uma das páginas seguintes.</p>
    </header>
    <ul class="prose mt">
      <li><a href="/">Início</a></li>
      {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
    </ul>
  </div>
</Base>
